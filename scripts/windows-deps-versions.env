# Pinned versions of third-party tools bundled with the Windows installer.
# Change here, then re-run scripts/fetch-windows-deps.sh. Upstream SHA256
# sidecars are fetched and verified by the script; no SHA needs to be
# maintained here.

KUBECTL_VERSION=v1.30.2
K9S_VERSION=v0.32.7
KUBELOGIN_VERSION=v1.29.2
